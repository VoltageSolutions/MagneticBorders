#include <winver.h>

1 ICON "@ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @MAJOR@,@MINOR@,@PATCH@,0
 PRODUCTVERSION @MAJOR@,@MINOR@,@PATCH@,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "VOLTAGE"
      VALUE "ProductName", "Magnetic Borders"
      VALUE "FileDescription", "Magnetic Borders"
      VALUE "FileVersion", "@VERSION@"
      VALUE "ProductVersion", "@VERSION@"
      VALUE "LegalCopyright", "\251 2026 Voltage Solutions LLC"
      VALUE "OriginalFilename", "magnetic-borders-rs.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
