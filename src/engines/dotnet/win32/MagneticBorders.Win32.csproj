<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <CsWin32PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</CsWin32PlatformTarget>
    <CsWin32PlatformTarget Condition="'$(CsWin32PlatformTarget)' == ''">x64</CsWin32PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <ProjectReference Include="..\app\MagneticBorders.Application.csproj" />
  </ItemGroup>
</Project>
