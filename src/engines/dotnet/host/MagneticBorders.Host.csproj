<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>MagneticBorders.Net</AssemblyName>
    <RootNamespace>MagneticBorders.Host</RootNamespace>
    <AssemblyTitle>Magnetic Borders</AssemblyTitle>
    <ApplicationIcon>..\..\..\common\assets\icon.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <!-- linux-x64 is not a target. With PublishAot, restore adds the RID of the machine it runs on, and Dependabot
         restores on Linux. Listing it keeps packages.lock.json the same on Windows and Linux, so locked restore passes. -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <LinkerArg Include="/Brepro" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <ProjectReference Include="..\win32\MagneticBorders.Win32.csproj" />
  </ItemGroup>
</Project>
