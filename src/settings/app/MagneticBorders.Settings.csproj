<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <AssemblyName>MagneticBorders.Settings</AssemblyName>
    <RootNamespace>MagneticBorders.Settings</RootNamespace>
    <AssemblyTitle>Magnetic Borders Settings</AssemblyTitle>
    <DefaultLanguage>en-US</DefaultLanguage>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <ApplicationIcon>..\..\common\assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <PublishAot>true</PublishAot>
    <!-- C#/WinRT generates unsafe interop code (vtables) for .NET types handed to WinUI; without this it generates none. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- The SettingsControls toolkit depends on the Microsoft.WindowsAppSDK metapackage; pin it to 1.8 and take none of its assets or those of its unused components (AI, ML, Widgets, DWrite, Runtime: AI/ML carried ONNX Runtime and DirectML). -->
    <PackageReference Include="Microsoft.WindowsAppSDK" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <ProjectReference Include="..\core\MagneticBorders.Settings.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Icons and brand art come from src/common/assets (single source of truth), linked into Assets\ at build time. -->
    <Content Include="..\..\common\assets\icon.ico;..\..\common\assets\icon-256.png;..\..\common\assets\icon-small-64.png" Link="Assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\common\assets\brand\*.svg" Link="Assets\brand\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
